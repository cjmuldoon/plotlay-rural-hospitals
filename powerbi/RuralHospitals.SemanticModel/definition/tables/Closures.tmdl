	partition Closures = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/closures.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"closure", "name", "town", "ended", "what", "beds_when_open"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"closure", type text}, {"name", type text}, {"town", type text}, {"ended", type text}, {"what", type text}, {"beds_when_open", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
