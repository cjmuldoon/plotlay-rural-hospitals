table States
	lineageTag: b8464cdd-84b5-f068-ad72-bf5c4f32163d

	/// Rural hospitals with losses in 3 or more of 2021-24 and a Medicaid share at or above the rural median
	measure 'Rural hospitals meeting the rule' = SUM ( States[meets_rule] )
		formatString: #,0
		lineageTag: af6096af-05ca-cc9f-1763-99a1f19c1126

	measure 'Rural hospitals with cost reports' = SUM ( States[rural_hospitals] )
		formatString: #,0
		lineageTag: 646c8d68-5ff5-03b3-75a6-f67449d6cf32

	column state
		dataType: string
		lineageTag: f7a372c7-4010-575b-129f-b66cb376ef69
		summarizeBy: none
		sourceColumn: state

		annotation SummarizationSetBy = Automatic

	column name
		dataType: string
		lineageTag: 3eaf74d8-5294-31e8-7dfd-f78c2f7095f6
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	column rural_hospitals
