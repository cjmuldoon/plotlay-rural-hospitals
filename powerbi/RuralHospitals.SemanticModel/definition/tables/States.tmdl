		sourceColumn: name_short

		annotation SummarizationSetBy = Automatic

	partition States = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/states.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"state", "name", "rural_hospitals", "loss_3plus", "meets_rule", "share_meeting"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"state", type text}, {"name", type text}, {"rural_hospitals", Int64.Type}, {"loss_3plus", Int64.Type}, {"meets_rule", Int64.Type}, {"share_meeting", type number}}, "en-US"),
				    ShortNames_name_short = [],
				    Short_name_short = Table.AddColumn(Typed, "name_short", each Record.FieldOrDefault(ShortNames_name_short, [name], [name]), type text)
				in
				    Short_name_short

	annotation PBI_ResultType = Table
