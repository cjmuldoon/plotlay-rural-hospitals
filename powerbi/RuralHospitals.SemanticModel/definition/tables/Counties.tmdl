table Counties
	lineageTag: f66c1590-e73d-e9cb-7cd7-503f13d80118

	/// Minutes the scenario adds to the county's average drive
	measure 'Minutes added' = AVERAGE ( Counties[mean_min_added] )
		formatString: 0.0
		lineageTag: 474c8446-3759-8063-3b3c-205e513458b0

	measure 'County average today' = AVERAGE ( Counties[mean_min_today] )
		formatString: 0.0
		lineageTag: 7254e061-d59e-c59b-475e-b4d4f902c405

	measure 'County average if they closed' = AVERAGE ( Counties[mean_min_scenario] )
