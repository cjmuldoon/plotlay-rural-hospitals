	partition Counties = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/counties.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"geoid", "name", "population", "over30_today", "over30_scenario", "mean_min_today", "mean_min_scenario", "mean_min_added"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"geoid", type text}, {"name", type text}, {"population", Int64.Type}, {"over30_today", Int64.Type}, {"over30_scenario", Int64.Type}, {"mean_min_today", type number}, {"mean_min_scenario", type number}, {"mean_min_added", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
