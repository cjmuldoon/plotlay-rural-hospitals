table BlockGroups
	lineageTag: 5f4c6192-3515-eaab-1fd7-c2c9ef41b0a7

	/// Residents, ACS 2020-24 5-year estimates
	measure People = SUM ( BlockGroups[population] )
		formatString: #,0
		lineageTag: 999fe085-6c2a-9265-2886-e88941749083

	/// Minutes to the nearest hospital, weighted by people
	measure 'Average drive today' = DIVIDE ( SUMX ( BlockGroups, BlockGroups[population] * BlockGroups[minutes_today] ), [People] )
		formatString: 0.0
		lineageTag: a8ef1edf-ab3c-09c4-b0f7-19973b3e6096

	measure 'Average drive if they closed' = DIVIDE ( SUMX ( BlockGroups, BlockGroups[population] * BlockGroups[minutes_scenario] ), [People] )
		formatString: 0.0
		lineageTag: 6bb1fcba-478d-7797-3a14-0a4119932a46

	measure 'Over 30 min today' = CALCULATE ( [People], BlockGroups[minutes_today] > 30 )
		formatString: #,0
		lineageTag: 6d994483-0149-66f0-7ad2-2b6703cfa513

	measure 'Over 30 min if they closed' = CALCULATE ( [People], BlockGroups[minutes_scenario] > 30 )
		formatString: #,0
		lineageTag: bbfef976-6b8d-76ae-b10d-da1953fe5ea8

	measure 'Over 45 min if they closed' = CALCULATE ( [People], BlockGroups[minutes_scenario] > 45 )
		formatString: #,0
		lineageTag: d1382ebe-cd42-e84d-3821-2c7dd378a818

	/// People whose drive would grow by more than half a minute
	measure 'Driving longer' = CALCULATE ( [People], BlockGroups[minutes_added] > 0.5 )
		formatString: #,0
		lineageTag: 83b735da-b5c0-3439-1f63-4b3095bce34e

	column geoid
		dataType: string
		lineageTag: 8e3ee845-a62a-ea34-b202-cdb2b4badeb4
