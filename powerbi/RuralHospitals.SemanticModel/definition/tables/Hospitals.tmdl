table Hospitals
	lineageTag: 2bc84779-6054-c051-667e-e4170b25ae41

	/// Oklahoma rural hospitals that meet the risk rule (closed in the scenario)
	measure 'Meet the rule' = CALCULATE ( COUNTROWS ( Hospitals ), LEFT ( Hospitals[in_scenario], 5 ) = "Meets" )
		formatString: #,0
		lineageTag: 7f26f398-5d09-b8c2-07d7-b4a1f6b875c7

	measure 'Beds of those meeting the rule' = CALCULATE ( SUM ( Hospitals[beds] ), LEFT ( Hospitals[in_scenario], 5 ) = "Meets" )
		formatString: #,0
		lineageTag: 2a57ec2e-c8ac-484c-b89e-e699c1e20bdc

	/// Average patients a day, May 2023 to April 2024
	measure 'Patients of those meeting the rule' = CALCULATE ( SUM ( Hospitals[patients] ), LEFT ( Hospitals[in_scenario], 5 ) = "Meets" )
		formatString: #,0
		lineageTag: e0e2218d-f096-d513-cc79-895e183acd1a

	/// Patients over beds for the hospitals in the filter
	measure 'In use today' = DIVIDE ( SUM ( Hospitals[patients] ), SUM ( Hospitals[beds] ) )
		formatString: 0%
		lineageTag: 15290341-3d25-4c64-e11e-7c2fdda2ca47

	/// Variant A: patients to the nearest hospital
	measure 'In use if they closed' = DIVIDE ( SUM ( Hospitals[patients] ) + SUM ( Hospitals[added_patients] ), SUM ( Hospitals[beds] ) )
		formatString: 0%
		lineageTag: 29f69f43-b0d3-401c-cfe7-caaebeb50952

	/// Variant B: patients to the nearest short-term general hospital
	measure 'In use, to a general hospital' = DIVIDE ( SUM ( Hospitals[patients] ) + SUM ( Hospitals[added_patients_b] ), SUM ( Hospitals[beds] ) )
		formatString: 0%
		lineageTag: a10b97f9-ab94-0f0d-fa82-3c8ed61bde4b

	/// Variant A, only for hospitals taking 5 or more patients a day
	measure 'In use if they closed, taking 5 or more' = IF ( SUM ( Hospitals[added_patients] ) >= 5, [In use if they closed] )
		formatString: 0%
		lineageTag: 61880f8d-3171-8f5a-183b-31f920a3ac68

	/// Hospitals taking patients in variant A that would be 85% full or more
	measure 'Receiving 85% or more' = COUNTROWS ( FILTER ( Hospitals, Hospitals[added_patients] > 0.5 && NOT ISBLANK ( Hospitals[occupancy_today] ) && Hospitals[occupancy_scenario] >= 85 ) )
		formatString: #,0
		lineageTag: 8fb956cc-fb0b-1763-d890-45a73c2bcbe1

