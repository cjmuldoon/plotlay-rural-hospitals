	partition Hospitals = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/hospitals.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"ccn", "name", "town", "state", "type", "rural", "in_scenario", "beds", "patients", "beds_source", "occupancy_today", "added_patients", "occupancy_scenario", "added_patients_b", "occupancy_scenario_b", "loss_years", "medicaid_share"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"ccn", type text}, {"name", type text}, {"town", type text}, {"state", type text}, {"type", type text}, {"rural", type text}, {"in_scenario", type text}, {"beds", type number}, {"patients", type number}, {"beds_source", type text}, {"occupancy_today", type number}, {"added_patients", type number}, {"occupancy_scenario", type number}, {"added_patients_b", type number}, {"occupancy_scenario_b", type number}, {"loss_years", type number}, {"medicaid_share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
