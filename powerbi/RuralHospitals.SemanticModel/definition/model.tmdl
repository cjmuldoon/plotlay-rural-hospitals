model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","Hospitals","BlockGroups","Counties","Closures","States","StateYears"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table Hospitals
ref table BlockGroups
ref table Counties
ref table Closures
ref table States
ref table StateYears

ref cultureInfo en-US
